# Copia este archivo a .env.local y completa los valores.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STUDIO_URL=http://localhost:3000

# Supabase (Auth + Postgres). En producción:
#   NEXT_PUBLIC_APP_URL=https://pagate.cl
#   NEXT_PUBLIC_STUDIO_URL=https://studio.pagate.cl
# Redirect URLs en Supabase Auth:
#   http://localhost:3000/auth/callback
#   https://studio.pagate.cl/auth/callback
#   https://pagate.cl/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Cloud OAuth — login de creadores (Supabase Google provider)
# Authorized JavaScript origins: http://localhost:3000, https://pagate.cl, https://studio.pagate.cl
# Redirect URI de Supabase: https://<project-ref>.supabase.co/auth/v1/callback

# Google Calendar (panel, scopes de calendario — NO mezclar con el login)
# Redirect URI autorizado:
#   http://localhost:3000/api/google/callback
#   https://studio.pagate.cl/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
